---
import SocialLinks from "./SocialLinks.astro";
import { AUTHOR } from "../consts";

const today = new Date();
---

<footer>
	<p class="credit">
		&copy; {today.getFullYear()}
		{AUTHOR}. Music rendered with Csound; scores engraved with LilyPond.
	</p>
	<SocialLinks />
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.credit {
		margin-bottom: 1em;
		font-size: 0.9em;
	}
	footer :global(.social-links) {
		justify-content: center;
		gap: 1em;
	}
</style>
