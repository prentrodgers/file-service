---
import { SOCIAL } from "../consts";
---

<div class="social-links">
	<a href={SOCIAL.x} target="_blank" rel="me noopener">
		<span class="sr-only">Prent Rodgers on X</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
			><path
				fill="currentColor"
				d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"
			></path></svg
		>
	</a>
	<a href={SOCIAL.substack} target="_blank" rel="me noopener">
		<span class="sr-only">Microtonal Notes on Substack</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
			><path
				fill="currentColor"
				d="M15 3.604H1v1.891h14V3.604ZM1 7.208V16l7-3.926L15 16V7.208H1ZM15 0H1v1.891h14V0Z"
			></path></svg
		>
	</a>
	<a href={SOCIAL.youtube} target="_blank" rel="me noopener">
		<span class="sr-only">Prent Rodgers on YouTube</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
			><path
				fill="currentColor"
				d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.135.306-5.062.334-6.11.335H7.95c-1.048-.001-4.975-.029-6.11-.335a2.007 2.007 0 0 1-1.415-1.42c-.111-.417-.185-.986-.235-1.558l-.009-.104-.008-.105A31.4 31.4 0 0 1 .1 7.68v-.075c.001-.187.009-1.043.074-1.957l.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c1.123-.302 5.288-.332 6.11-.335h.092ZM6.4 5.209v4.818l4.157-2.408L6.4 5.209Z"
			></path></svg
		>
	</a>
	<a href={SOCIAL.github} target="_blank" rel="noopener">
		<span class="sr-only">The tuning code on GitHub</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
			><path
				fill="currentColor"
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
			></path></svg
		>
	</a>
</div>

<style>
	.social-links {
		display: flex;
		gap: 0.5em;
	}
	.social-links a {
		display: flex;
		padding: 0.25em;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
